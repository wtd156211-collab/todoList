.month-calendar { padding: 28rpx; border-radius: 28rpx; background: #ffffff; box-shadow: 0 8rpx 30rpx rgba(15, 23, 42, .06); }
.weekdays { display: grid; grid-template-columns: repeat(7, 1fr); color: #64748b; font-size: 24rpx; text-align: center; }
.calendar-note { padding-top: 36rpx; color: #94a3b8; font-size: 26rpx; text-align: center; }
